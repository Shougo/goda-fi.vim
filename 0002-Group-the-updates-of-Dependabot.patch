From 86b463c5ac4a0b850ec128098bc8bc2b47e91f19 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 06:50:57 +0900
Subject: [PATCH 2/2] Group the updates of Dependabot

One pull request a week for all the updates (the Go modules and the
GitHub Actions), not one for each: those of the same go.mod conflicted
with each other, and they were many.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SYHssS6AaBazouHGF6zQqm
---
 .github/dependabot.yml | 30 ++++++++++++++++++++++++------
 1 file changed, 24 insertions(+), 6 deletions(-)

diff --git a/.github/dependabot.yml b/.github/dependabot.yml
index 19e338f..f1d5238 100644
--- a/.github/dependabot.yml
+++ b/.github/dependabot.yml
@@ -1,12 +1,17 @@
-# Dependabot: updates of the GitHub Actions and of the Go modules,
-# once a week, of releases at least 7 days old (time for a broken or malicious
-# release to be found).
+# Dependabot: updates of the GitHub Actions and of the Go modules, once a
+# week, of releases at least 7 days old (time for a broken or malicious
+# release to be found), all in one pull request (one for each conflicted
+# with the others in go.mod and go.sum, and they were many).
 version: 2
+multi-ecosystem-groups:
+  dependencies:
+    schedule:
+      interval: weekly
 updates:
   - package-ecosystem: gomod
-    directories:
-      - /
-      - /e2e
+    directory: /
+    patterns: ["*"]
+    multi-ecosystem-group: dependencies
     schedule:
       interval: weekly
     cooldown:
@@ -14,8 +19,21 @@ updates:
       # Our own modules: at once.
       exclude:
         - github.com/Shougo/*
+  # The end-to-end tests: a module of their own.
+  - package-ecosystem: gomod
+    directory: /e2e
+    patterns: ["*"]
+    multi-ecosystem-group: dependencies
+    schedule:
+      interval: weekly
+    cooldown:
+      default-days: 7
+      exclude:
+        - github.com/Shougo/*
   - package-ecosystem: github-actions
     directory: /
+    patterns: ["*"]
+    multi-ecosystem-group: dependencies
     schedule:
       interval: weekly
     cooldown:
-- 
